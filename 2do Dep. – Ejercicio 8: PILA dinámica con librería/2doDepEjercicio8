#include <iostream>
#include <stack>

using namespace std;

int main() {
    stack<int> miPila;
    int opcion, dato;

    do {
        cout << "\n1. Push\n2. Pop\n3. Top\n4. Vacia\n5. Tamanio\n6. Salir\nOpcion: ";
        cin >> opcion;

        switch(opcion) {
            case 1:
                cout << "Dato: ";
                cin >> dato;
                miPila.push(dato);
                break;
            case 2:
                if(!miPila.empty()) {
                    miPila.pop();
                    cout << "Elemento eliminado." << endl;
                } else {
                    cout << "Pila vacia." << endl;
                }
                break;
            case 3:
                if(!miPila.empty()) {
                    cout << "Cima: " << miPila.top() << endl;
                } else {
                    cout << "Pila vacia." << endl;
                }
                break;
            case 4:
                cout << (miPila.empty() ? "Si" : "No") << endl;
                break;
            case 5:
                cout << "Tamanio: " << miPila.size() << endl;
                break;
            case 6:
                break;
        }
    } while(opcion != 6);

    return 0;
}
